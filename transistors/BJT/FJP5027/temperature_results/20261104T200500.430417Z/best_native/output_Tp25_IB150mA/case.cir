E_COUT cout_drive 0 scan 0 {POL*VCE_SWEEP}
R_COUT cout_drive cout_feed {R_COLLECTOR}
V_ICOUT cout_feed c_out 0
I_BOUT 0 b_out {POL*IB_TEST}
X_OUT c_out b_out 0 0 DUT_BJT
B_VCO vce_out 0 V={POL*V(c_out)}
B_ICO ic_out 0 V={POL*I(V_ICOUT)}
.temp 25
.param VCE_SWEEP=8
.param R_COLLECTOR=0.001
.param IB_TEST=0.15
.param IC_SAT_REF=5m
.param VCE_GUMMEL=5
.param VBE_START=0
.param VBE_STOP=0.9
.param VBLOCK_SCAN=20
.param IB_FLOOR=1p
.param SCAN_STEP=0.00025
.options reltol=1e-5 abstol=1e-13 vntol=1e-8
.dc V_SCAN 0 1 {SCAN_STEP}
.param POL=1
