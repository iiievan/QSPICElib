  «text (100,1300) 1 7 0 0x1000000 -1 -1 "ï»¿.temp 25\n.param VTH_SCAN=5\n.param R_TH=100\n.param I_TH=250u\n.param VREVERSE_SCAN=3\n.param R_REVERSE=1\n.param I_REVERSE=0.5\n.param VGS_REVERSE=0\n.param VBLOCK_SCAN=50\n.param VGS_OFF=0\n.param VGATE_LEAK_SCAN=4.5\n.param SCAN_STEP=1m"»
  «text (50,-9650) 1 7 0 0x1000000 -1 -1 "ï»¿.options reltol=1e-5 abstol=1e-13 vntol=1e-8\n.dc V_SCAN 0 1 {SCAN_STEP}"»
  «text (50,-10000) 1 7 0 0x1000000 -1 -1 "ï»¿.plot V(scan) V(vth) V(ith) V(vsd) V(isd) V(vds_off) V(idss) V(vgs_leak) V(igss)"»
  «text (50,-10650) 1 7 0 0x1000000 -1 -1 "ï»¿.meas DC VTH_AT_ITH FIND V(vth) WHEN V(ith)={I_TH} CROSS=1\n.meas DC VSD_AT_IS FIND V(vsd) WHEN V(isd)={I_REVERSE} CROSS=1\n.meas DC IDSS_AT_END FIND V(idss) AT=1\n.meas DC IGSS_AT_END FIND V(igss) AT=1\n.meas DC ACTUAL_BLOCKING_V FIND V(vds_off) AT=1"»
