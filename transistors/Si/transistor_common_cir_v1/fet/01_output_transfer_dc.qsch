  «text (-650,-250) 1 7 0 0x1000000 -1 -1 "ï»¿.temp 25\n.param VGS_TEST=4.5\n.param VDS_SWEEP=2\n.param R_BALLAST=1\n.param I_RON=0.5\n.param VDS_TRANSFER=5\n.param VGS_START=0\n.param VGS_STOP=3.3\n.param TRANSFER_IREF=250u\n.param SCAN_STEP=1m\n.param I_FLOOR=1n"»
  «text (-1100,-8050) 1 7 0 0x1000000 -1 -1 "ï»¿.options reltol=1e-5 abstol=1e-12 vntol=1e-8\n.dc V_SCAN 0 1 {SCAN_STEP}"»
  «text (-1100,-8400) 1 7 0 0x1000000 -1 -1 "ï»¿.plot V(scan) V(vds_out) V(id_out) V(rds_out) V(vgs_transfer) V(id_transfer) V(vds_transfer_actual)"»
  «text (-1100,-8950) 1 7 0 0x1000000 -1 -1 "ï»¿.meas DC RDS_AT_ID FIND V(rds_out) WHEN V(id_out)={I_RON} CROSS=1\n.meas DC VDS_AT_ID FIND V(vds_out) WHEN V(id_out)={I_RON} CROSS=1\n.meas DC TRANSFER_VGS FIND V(vgs_transfer) WHEN V(id_transfer)={TRANSFER_IREF} CROSS=1\n.meas DC OUTPUT_ID_MAX MAX V(id_out)"»
