  «text (-800,-50) 1 7 0 0x1000000 -1 -1 "ï»¿.temp 25\n.param VCE_SWEEP=10\n.param R_COLLECTOR=1\n.param IB_TEST=100u\n.param IC_SAT_REF=5m\n.param VCE_GUMMEL=5\n.param VBE_START=0\n.param VBE_STOP=0.9\n.param VBLOCK_SCAN=20\n.param IB_FLOOR=1p\n.param SCAN_STEP=1m"»
  «text (-1500,-9000) 1 7 0 0x1000000 -1 -1 "ï»¿.options reltol=1e-5 abstol=1e-13 vntol=1e-8\n.dc V_SCAN 0 1 {SCAN_STEP}\n.plot V(scan) V(vce_out) V(ic_out) V(vbe) V(ic_gummel) V(ib_gummel) V(hfe) V(hfe_valid) V(vce_leak) V(iceo) V(ices)"»
  «text (-1550,-9850) 1 7 0 0x1000000 -1 -1 "ï»¿.meas DC VCE_AT_IC FIND V(vce_out) WHEN V(ic_out)={IC_SAT_REF} CROSS=1\n.meas DC ICEO_END FIND V(iceo) AT=1\n.meas DC ICES_END FIND V(ices) AT=1\n.meas DC IC_GUMMEL_END FIND V(ic_gummel) AT=1\n.meas DC IB_GUMMEL_END FIND V(ib_gummel) AT=1"»
