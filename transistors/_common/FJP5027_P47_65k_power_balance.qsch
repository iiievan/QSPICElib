  «text (800,6100) 1 7 0 0x1000000 -1 -1 "ï»¿.param FSW=65K VBUS_DC=240 RLOAD=40\n.param LM_REF=743.7540558385u IPK_CMD=0.61\n.param IB_FWD=120m IB_REV=180m TREV=500n TEDGE=10n\n.param RBASE=1 RBE=330 VDRV_MAX=3 VDRV_MIN=-2 RCOMP=100m\n.param RCLAMP=47K CCLAMP=47n COUT=940u RESR=20m\n.param VOUT_INIT=18 VCL_INIT=155\n.param NCYC=24 NMEAS=4 DTMAX=25n\n.param TPER={1/FSW}\n.param TON={LM_REF*IPK_CMD/VBUS_DC}\n.param TDELAY={2*TPER}\n.param TREVERSE={TDELAY+TON+2*TEDGE}\n.param TSTOP={TDELAY+NCYC*TPER}\n.param TMEAS={TSTOP-NMEAS*TPER}\n.param TPREV={TMEAS-NMEAS*TPER}"»
  «text (850,4550) 1 7 0 0x1000000 -1 -1 "ï»¿.param RVD_OHM=10"»
  «text (-450,-5650) 1 7 0 0x1000000 -1 -1 "ï»¿.ic V(SEC_RETURN)=0 V(OUT_CAP)={VOUT_INIT} V(CLAMP)={VBUS_DC+VCL_INIT}\n.temp 25\n.options reltol=1e-4 abstol=1e-10 vntol=1e-7\n.tran 0 {TSTOP+1n} 0 {DTMAX}"»
  «text (-550,-8300) 1 7 0 0x1000000 -1 -1 "ï»¿.meas TRAN VOUT_AVG_PREV AVG V(VOUT_MON) FROM={TPREV} TO={TMEAS}\n.meas TRAN VOUT_AVG AVG V(VOUT_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN VOUT_MIN MIN V(VOUT_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN VOUT_MAX MAX V(VOUT_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN VCE_PK MAX V(COL) FROM={TMEAS} TO={TSTOP}\n.meas TRAN IC_PK MAX V(IC_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN IB_PK MAX V(IB_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN IB_REV_PK MIN V(IB_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN VBE_MIN MIN V(BASE) FROM={TMEAS} TO={TSTOP}\n.meas TRAN VBE_MAX MAX V(BASE) FROM={TMEAS} TO={TSTOP}\n.meas TRAN I_FR103_PK MAX V(ID_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN I_FR103_AVG AVG V(ID_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN VR_FR103_PK MAX V(VR_OUT_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN VR_ES1J_PK MAX V(VR_CL_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN V_RCD_CAP_PK MAX V(VCL_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN P_RCD_RES_AVG AVG V(P_RCD_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN P_KEY_TERM_AVG AVG V(P_KEY_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN P_FR103_AVG AVG V(P_FR_MON) FROM={TMEAS} TO={TSTOP}\n.meas TRAN P_LOAD_AVG AVG V(P_OUT_MON) FROM={TMEAS} TO={TSTOP}"»
