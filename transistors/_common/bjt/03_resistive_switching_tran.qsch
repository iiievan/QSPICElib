  «text (-9250,2550) 1 7 0 0x1000000 -1 -1 "ï»¿.temp 25\n.param VBUS=20\n.param R_LOAD=100\n.param IB_ON=10m\n.param IB_OFF=-20m\n.param R_BASE=1\n.param VBE_MAX=2\n.param VBE_MIN=-3\n.param R_COMPLIANCE=1m\n.param IC_REFERENCE=0.2\n.param FSW=100k\n.param DUTY=0.5\n.param T_DELAY=1u\n.param T_EDGE=5n\n.param N_CYCLES=4\n.param T_MAX=1n\n.param TPER={1/FSW}\n.param TON={DUTY*TPER-T_EDGE}\n.param T_STOP={T_DELAY+N_CYCLES*TPER}\n.param T_AVG0={T_DELAY+(N_CYCLES-1)*TPER}"»
  «text (-11100,-3750) 1 7 0 0x1000000 -1 -1 "ï»¿.options reltol=1e-5 abstol=1e-12 vntol=1e-8\n.tran 0 {T_STOP} 0 {T_MAX}"»
  «text (-11100,-4100) 1 7 0 0x1000000 -1 -1 "ï»¿.plot V(cmd) V(vce) V(vbe) V(ic) V(ib) V(ic_ratio) V(p_collector) V(p_base) V(p_total)"»
  «text (-11100,-5350) 1 7 0 0x1000000 -1 -1 "ï»¿.meas TRAN T_DELAY_ON TRIG V(cmd)=0.1 RISE=1 TARG V(ic_ratio)=0.1 RISE=1\n.meas TRAN T_RISE_IC TRIG V(ic_ratio)=0.1 RISE=1 TARG V(ic_ratio)=0.9 RISE=1\n.meas TRAN T_STORAGE_CMD TRIG V(cmd)=0.9 FALL=1 TARG V(ic_ratio)=0.9 FALL=1\n.meas TRAN T_STORAGE_IB TRIG V(ib)=0 FALL=1 TARG V(ic_ratio)=0.9 FALL=1\n.meas TRAN T_FALL_IC TRIG V(ic_ratio)=0.9 FALL=1 TARG V(ic_ratio)=0.1 FALL=1\n.meas TRAN IC_PEAK MAX V(ic)\n.meas TRAN IB_FORWARD_PEAK MAX V(ib)\n.meas TRAN IB_REVERSE_PEAK MIN V(ib)\n.meas TRAN P_TOTAL_AVG AVG V(p_total) FROM={T_AVG0} TO={T_STOP}\n.meas TRAN P_COLLECTOR_AVG AVG V(p_collector) FROM={T_AVG0} TO={T_STOP}\n.meas TRAN P_BASE_AVG AVG V(p_base) FROM={T_AVG0} TO={T_STOP}"»
»

