  «text (-400,-1650) 1 7 0 0x1000000 -1 -1 "ï»¿.temp 25\n.param VBUS=24\n.param L_LOAD=500u\n.param R_L=50m\n.param L_BUS=5n\n.param R_BUS=50m\n.param L_SOURCE=1n\n.param R_SOURCE=1m\n.param KELVIN_RETURN=0\n.param R_RETURN_ON=1u\n.param R_RETURN_OFF=1T\n.param R_GON=6.8\n.param R_GOFF=6.8\n.param VGS_OFF=0\n.param VGS_ON=4.5\n.param VGS_FREEWHEEL=0\n.param T_DELAY=1u\n.param TON1=5u\n.param TOFF_GAP=2u\n.param TON2=1u\n.param T_EDGE=2n\n.param EDGE_WINDOW=300n\n.param T_TAIL=3u\n.param T_MAX=0.5n\n.param T1_FALL={T_DELAY+T_EDGE+TON1}\n.param T2_RISE={T1_FALL+T_EDGE+TOFF_GAP}\n.param T2_FALL={T2_RISE+T_EDGE+TON2}\n.param T_STOP={T2_FALL+T_EDGE+T_TAIL}"»
  «text (-50,-9700) 1 7 0 0x1000000 -1 -1 "ï»¿.options reltol=1e-5 abstol=1e-12 vntol=1e-8\n.tran 0 {T_STOP} 0 {T_MAX}"»
  «text (-50,-10000) 1 7 0 0x1000000 -1 -1 "ï»¿.plot V(cmd) V(vds) V(vds_power) V(vs_minus_k) V(vgs) V(id) V(iload) V(ig) V(i_high_forward) V(i_high_reverse) V(v_high) V(p_drain) V(p_gate) V(q_comm_nC)"»
  «text (-50,-10800) 1 7 0 0x1000000 -1 -1 "ï»¿.meas TRAN I_AT_FIRST_OFF FIND V(iload) AT={T1_FALL}\n.meas TRAN VDS_PEAK MAX V(vds)\n.meas TRAN ID_PEAK MAX V(id)\n.meas TRAN HIGH_REVERSE_PEAK MAX V(i_high_reverse) FROM={T2_RISE} TO={T2_RISE+EDGE_WINDOW}\n.meas TRAN Q_COMM_NC FIND V(q_comm_nC) AT={T_STOP}\n.meas TRAN E_ON_WINDOW INTEG V(p_drain) FROM={T2_RISE} TO={T2_RISE+EDGE_WINDOW}\n.meas TRAN E_OFF_WINDOW INTEG V(p_drain) FROM={T1_FALL} TO={T1_FALL+EDGE_WINDOW}"»
