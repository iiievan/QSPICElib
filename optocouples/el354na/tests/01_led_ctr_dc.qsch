  «text (6250,-6400) 1 7 0 0x1000000 -1 -1 "ï»¿.meas DC CTR_POS FIND V(ctr_pos) AT=1m\n.meas DC CTR_NEG FIND V(ctr_neg) AT=1m\n.meas DC CTR_SYM MAX V(ctr_sym)\n.meas DC VF20_TYP FIND V(led_pos) AT=20m\n.meas DC VF20_MAX FIND V(led_pos) AT=20m\n.meas DC VF20_REV_MAX FIND V(led_neg) AT=20m\n.meas DC VF1_DIAGNOSTIC FIND V(led_pos) AT=1m\n.meas DC LED_SYM20 FIND abs(V(led_pos)-V(led_neg)) AT=20m\n.meas DC LED_SYM1 FIND abs(V(led_pos)-V(led_neg)) AT=1m\n.meas DC CTR_FIG3_0P5M FIND V(ctr_fig3) AT=0.5m\n.meas DC CTR_FIG3_1M FIND V(ctr_fig3) AT=1m\n.meas DC CTR_FIG3_2M FIND V(ctr_fig3) AT=2m\n.meas DC CTR_FIG3_5M FIND V(ctr_fig3) AT=5m\n.meas DC CTR_FIG3_10M FIND V(ctr_fig3) AT=10m\n.meas DC CTR_FIG3_20M FIND V(ctr_fig3) AT=20m\n.meas DC CTR_FIG3_30M FIND V(ctr_fig3) AT=30m"»
