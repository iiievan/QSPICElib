  «text (850,-500) 1 7 0 0x1000000 -1 -1 "ï»¿.options reltol=1e-4 abstol=1e-12 vntol=1e-7\n.param IF_TEST=1m CTR_TEST=0.5 OPTO_TAU=2u\n.step param IF_TEST list 0.5m 1m 5m 10m 25m"»
  «text (1250,-10150) 1 7 0 0x1000000 -1 -1 "ï»¿.dc TEMP -35 60 1"»
  «text (2950,-11750) 1 7 0 0x1000000 -1 -1 "ï»¿.meas DC ACTUAL_TEMP_MIN MIN V(actual_temp)\n.meas DC ACTUAL_TEMP_MAX MAX V(actual_temp)\n.meas DC CTR_AT_25 FIND V(ctr_pos) AT=25\n.meas DC CTR_AT_COLD FIND V(ctr_pos) AT=-35\n.meas DC CTR_AT_HOT FIND V(ctr_pos) AT=60\n.meas DC CTR_NEG_AT_25 FIND V(ctr_neg) AT=25\n.meas DC CTR_NEG_AT_COLD FIND V(ctr_neg) AT=-35\n.meas DC CTR_NEG_AT_HOT FIND V(ctr_neg) AT=60\n.meas DC CTR_SYM MAX V(ctr_sym)\n.meas DC F_T_COLD PARAM CTR_AT_COLD/CTR_AT_25\n.meas DC F_T_HOT PARAM CTR_AT_HOT/CTR_AT_25\n.meas DC IC_NORM_AT_25 FIND V(ic_norm) AT=25\n.meas DC VF_AT_COLD FIND V(led_pos) AT=-35\n.meas DC VF_AT_25 FIND V(led_pos) AT=25\n.meas DC VF_AT_HOT FIND V(led_pos) AT=60\n.meas DC ICEO_20V_AT_25 FIND V(idark20) AT=25\n.meas DC ICEO_20V_AT_60 FIND V(idark20) AT=60\n.meas DC ICEO_3V3_AT_60 FIND V(idark3) AT=60"»
  «text (2950,-13800) 1 7 0 0x1000000 -1 -1 "ï»¿.plot 100*V(ctr_pos) 100*V(ctr_neg) V(ctr_sym) V(ic_norm) V(led_pos) 1e9*V(idark20) 1e9*V(idark3) V(actual_temp)\n"»
»

