# =============================================================================
# S6061NS_halfbridge_static_test.cir - APPLICATION REQUIREMENTS
#
# These are project limits, not FDS4559 datasheet typical values.
# Each result is produced for TEMP = -35, +25, +60 C; a single expected value
# is intentionally reused for all three steps by run_tests.sh.
# =============================================================================
# measurement          mode   tolerance  requirement

# Power-path drop: <=100 mV even at the 0.5 A squeeze target.
# The 0.15 A path gets a tighter 50 mV limit.
HB_H15_DROP_MAX         max    0          0.050
HB_H50_DROP_MAX         max    0          0.100
HB_L15_DROP_MAX         max    0          0.050
HB_L50_DROP_MAX         max    0          0.100

# P-MOS ON: keep enough overdrive but stay well away from gate-stress region.
# 6...15 V also remains compatible with the future 18 V bus using 1k/1k.
HB_H15_VSG_MIN          min    0          6.0
HB_H15_VSG_MAX          max    0          15.0
HB_H50_VSG_MIN          min    0          6.0
HB_H50_VSG_MAX          max    0          15.0

# N-MOS ON: 74HCT244 must deliver a proper 5 V-class gate level.
HB_L15_VGS_MIN          min    0          4.5
HB_L15_VGS_MAX          max    0          5.5
HB_L50_VGS_MIN          min    0          4.5
HB_L50_VGS_MAX          max    0          5.5

# Static OFF-state gate margins.
HB_H15_NG_OFF           max    0          0.30
HB_H50_NG_OFF           max    0          0.30
HB_L15_PG_OFF           max    0          0.30
HB_L50_PG_OFF           max    0          0.30

# ULQ max-corner open collector should still be strongly saturated from 3.3 V.
HB_ULQ_VCE_MAX          max    0          1.20
