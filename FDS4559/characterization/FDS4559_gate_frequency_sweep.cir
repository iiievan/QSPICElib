.meas TRAN R0022_NGATE AVG V(nd_R0022,ng_R0022)*I(R_GN_R0022) FROM={TSTART+TPER} TO={TSTART+3*TPER}
.meas TRAN R0022_PFET AVG abs(V(ps_R0022,sw_R0022)*I(V_SP_R0022)) FROM={TSTART+TPER} TO={TSTART+3*TPER}
.meas TRAN R0022_NFET AVG abs(V(sw_R0022,ns_R0022)*I(V_SN_R0022)) FROM={TSTART+TPER} TO={TSTART+3*TPER}
.meas TRAN R0022_P_TR TRIG V(ps_R0022,pg_R0022)=1 RISE=2 TARG V(ps_R0022,pg_R0022)=9 RISE=2
.meas TRAN R0022_P_TF TRIG V(ps_R0022,pg_R0022)=9 FALL=2 TARG V(ps_R0022,pg_R0022)=1 FALL=2
.meas TRAN R0022_N_TR TRIG V(ng_R0022,ns_R0022)=0.5 RISE=2 TARG V(ng_R0022,ns_R0022)=4.5 RISE=2
