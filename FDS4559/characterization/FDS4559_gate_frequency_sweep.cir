.meas TRAN R0047_P_TR TRIG V(ps_R0047,pg_R0047)=1 RISE=2 TARG V(ps_R0047,pg_R0047)=9 RISE=2
.meas TRAN R0047_P_TF TRIG V(ps_R0047,pg_R0047)=9 FALL=2 TARG V(ps_R0047,pg_R0047)=1 FALL=2
